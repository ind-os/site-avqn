---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Testimonials from "../components/Testimonials.astro";

const title =
  "Consultant IA en Suisse romande : Claude Code et agents IA | AVQN";
const description =
  "Consultant IA indépendant à Lausanne. Coaching Claude Code, agents IA sur mesure et automatisation n8n pour les indépendants et PME romandes.";

const faqs = [
  {
    question: "Combien coûte un consultant IA en Suisse ?",
    answer:
      "Cela dépend du périmètre : un agent IA, un outil sur mesure ou une formation n'ont pas le même volume de travail. Je fonctionne au forfait, cadré après un premier échange.",
  },
  {
    question: "Vous travaillez avec quels outils ?",
    answer:
      "Claude Code pour construire des applications et des outils métier, n8n pour automatiser ce qui circule entre vos logiciels existants, des agents IA quand il faut une compétence permanente. Le choix se fait après un premier échange.",
  },
  {
    question: "Consultant IA indépendant ou agence : que choisir ?",
    answer:
      "Avec un consultant indépendant, vous avez un interlocuteur unique qui conçoit, construit et forme. Mon parti pris : vous rendre autonome plutôt que captif. Mes clients font évoluer eux-mêmes leurs outils après la mission.",
  },
  {
    question:
      "Faut-il être une grande entreprise pour travailler avec un consultant IA ?",
    answer:
      "Non. Je travaille principalement avec des indépendants et des PME romandes de 1 à 50 personnes. Les premiers résultats arrivent souvent en quelques semaines, sur un périmètre réduit.",
  },
  {
    question: "Mes données restent-elles en Suisse ?",
    answer:
      "C'est un choix d'architecture que je privilégie : hébergement en Suisse, outils open source que vous maîtrisez, gouvernance conforme à la LPD (minimisation, traçabilité, contrôle des accès).",
  },
  {
    question:
      "Quelle est la différence entre un consultant IA et un développeur ?",
    answer:
      "Le développeur écrit du code sur spécifications. Un consultant IA part de votre activité : identifier où l'IA a un vrai impact, construire, puis former vos équipes. Avec 20 ans de développement et Claude Code au quotidien, je fais les deux.",
  },
  {
    question: "Comment se passe le premier contact ?",
    answer:
      "Un premier échange, sans engagement : on cartographie vos processus, on identifie les projets IA à fort impact, on estime le retour sur investissement.",
  },
];

// Les quatre voies d'accès, dans l'ordre où on les propose.
const voies = [
  {
    titre: "Coaching IA pour indépendants",
    texte:
      "Apprendre à construire vos outils vous-même, en tête-à-tête, sur vos vrais projets. Trois séances de deux heures. À la fin, vous n'avez plus besoin de moi.",
    href: "/coaching-ia-independant-suisse",
  },
  {
    titre: "Formation IA en entreprise",
    texte:
      "Six semaines avec quatre à six personnes de votre équipe, sur vos dépôts : conventions communes, revue adaptée, garde-fous. La capacité reste dans l'équipe.",
    href: "/formation-ia-entreprise-suisse",
  },
  {
    titre: "CTO IA à la demande",
    texte:
      "Je tiens la direction technique le temps du projet : je décide avec vous quoi construire, je le construis, je le mets en production et je vous passe les clés.",
    href: "/expert-ia-suisse",
  },
  {
    titre: "Bootcamp IA",
    texte:
      "Un format collectif à date fixe, sans prérequis technique : vous repartez avec vos propres automatisations qui tournent. Préinscriptions pour la session 2027.",
    href: "/bootcamp-ia-suisse",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<Layout
  title={title}
  description={description}
  structuredData={faqJsonLd}
  hideGlobalCta
>
  <PageHeader
    title="Consultant IA en Suisse romande"
    subtitle="J'aide les indépendants et PME romandes à construire avec l'IA plutôt qu'à la subir : prendre Claude Code en main, se doter d'agents sur mesure, automatiser ce qui peut l'être."
    breadcrumb={[{ label: "Consultant IA" }]}
    ctaText="Parler de votre projet"
    ctaHref="/contact"
    ctaSecondaryText="Découvrir Claude Code"
    ctaSecondaryHref="/claude-code-suisse"
  />

  <main class="min-h-screen">
    {/* 1. Ce qu'un consultant IA fait pour vous */}
    <section class="border-b border-divider">
      <div
        class="container-custom border-divider xl:border-l xl:border-r px-6 md:px-8 py-14 md:py-20 space-y-10"
      >
        <div class="max-w-4xl space-y-5">
          <h2 class="text-3xl md:text-4xl">
            Ce qu'un consultant IA fait pour vous
          </h2>
          <p class="text-lg text-grey leading-relaxed">
            Mon travail est que l'IA produise des résultats mesurables dans
            votre activité. Quatre façons d'y accéder ; je vous dis laquelle a
            du sens chez vous avant que vous engagiez un franc.
          </p>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {
            voies.map((voie) => (
              <a
                href={voie.href}
                class="block border border-divider rounded-md p-6 hover:border-ink transition-colors"
              >
                <h3 class="text-xl mb-2">{voie.titre}</h3>
                <p class="text-grey">{voie.texte}</p>
              </a>
            ))
          }
        </div>
        <p class="text-lg text-grey leading-relaxed max-w-4xl">
          Les trois premières se départagent sur une seule question : qui
          construit. <a href="/services" class="font-bold underline"
            >Comparer les formats côte à côte</a
          >. Le choix de l'outil, lui, vient après :
          <a href="/claude-code-suisse" class="font-bold underline"
            >Claude Code</a
          > pour construire ce qui n'existe pas,
          <a href="/n8n-suisse" class="font-bold underline">n8n</a> pour faire circuler
          l'information entre vos logiciels.
        </p>
      </div>
    </section>

    {/* 2. Consultant vs agence */}
    <section class="border-b border-divider bg-paper2">
      <div
        class="container-custom border-divider xl:border-l xl:border-r px-6 md:px-8 py-14 md:py-20 space-y-10"
      >
        <div class="max-w-4xl space-y-5">
          <h2 class="text-3xl md:text-4xl">
            Consultant indépendant ou agence IA ?
          </h2>
          <p class="text-lg text-grey leading-relaxed">
            Une agence IA vous affecte une équipe, des process et des couches de
            coordination : pertinent pour les grands comptes. Pour un
            indépendant ou une PME romande, le calcul est différent.
          </p>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="border border-divider bg-paper2 rounded-md p-6">
            <h3 class="text-xl mb-2">Un interlocuteur unique</h3>
            <p class="text-grey">
              La personne qui comprend votre besoin est celle qui construit la
              solution et vous forme. Rien ne se perd en route.
            </p>
          </div>
          <div class="border border-divider bg-paper2 rounded-md p-6">
            <h3 class="text-xl mb-2">Pas de captivité</h3>
            <p class="text-grey">
              Outils open source, hébergement qui vous appartient, documentation
              et formation. À la fin de la mission, vous avez les clés.
            </p>
          </div>
          <div class="border border-divider bg-paper2 rounded-md p-6">
            <h3 class="text-xl mb-2">L'autonomie comme objectif</h3>
            <p class="text-grey">
              Mon critère de réussite : que vous puissiez faire évoluer vos
              outils sans moi.
            </p>
          </div>
        </div>
        <blockquote
          class="border border-divider bg-paper2 rounded-md p-8 max-w-4xl text-lg text-grey leading-relaxed"
        >
          « Contrairement à d'autres prestataires qui nous auraient rendu
          captifs de leurs services, Emmanuel nous a formés pour voler de nos
          propres ailes. Un vrai partenaire pour les entreprises qui veulent
          prendre le virage de l'IA et de l'automatisation. »
          <footer
            class="mt-4 font-mono text-sm uppercase tracking-widest text-grey"
          >
            Ewen Kerharo · Vétérinaire directeur, Groupe Vetmint
          </footer>
        </blockquote>
      </div>
    </section>

    <Testimonials />

    {/* 3. FAQ */}
    <section class="border-b border-divider">
      <div
        class="container-custom border-divider xl:border-l xl:border-r px-6 md:px-8 py-14 md:py-20"
      >
        <h2 class="text-3xl md:text-4xl mb-10">
          Les questions qu'on me pose avant de démarrer
        </h2>
        <div class="grid gap-0 border-t border-divider">
          {
            faqs.map((faq, index) => (
              <div class="py-8 border-b border-divider">
                <div class="flex gap-4 md:gap-6">
                  <span class="kicker shrink-0 self-start pt-1 tabular-nums">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <h3 class="text-lg md:text-xl mb-4">{faq.question}</h3>
                    <p class="text-grey leading-relaxed max-w-3xl">
                      {faq.answer}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
        <p class="text-grey mt-8">
          <a href="/ia-lpd-suisse" class="font-bold underline"
            >IA, LPD et données suisses : l'approche en détail</a
          >
        </p>
      </div>
    </section>

    {/* 4. CTA */}
    <section class="border-b border-divider bg-paper2">
      <div
        class="container-custom border-divider xl:border-l xl:border-r px-6 md:px-8 py-14 md:py-20"
      >
        <h2 class="text-3xl md:text-4xl mb-4">Commencez par un message</h2>
        <p class="text-lg text-grey leading-relaxed max-w-3xl mb-8">
          Un premier échange sans engagement : on cartographie vos processus, on
          identifie les projets à fort impact, vous repartez avec une vision
          claire.
        </p>
        <a
          href="/contact"
          class="inline-block px-10 py-5 rounded-md bg-swiss text-paper font-semibold text-sm hover:bg-swiss-dark transition-colors"
        >
          Parler de votre projet
        </a>
        <p class="text-sm text-grey mt-4">Sans engagement.</p>
      </div>
    </section>
  </main>
</Layout>
