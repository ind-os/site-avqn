---
/**
 * Hero de la home — le surtitre, le titre, la phrase de positionnement et les
 * trois chiffres
 * tiennent la colonne gauche. La colonne droite porte la carte profil : c'est
 * l'objet posé sur le quadrillage, le seul de l'écran (contour `trait`, ombre
 * dure teintée). Avatar, identité, et les deux actions du site.
 */
const chiffres = [
  { valeur: "+50 000", libelle: "heures de développement" },
  { valeur: "+150", libelle: "projets livrés" },
  { valeur: "+45 000", libelle: "automatisations téléchargées" },
];
---

<section id="hero-section" class="quadrillage border-b border-divider">
  {
    /* Deux groupes de cases allumées, dans les marges, jamais sous un texte.
       Celles de droite se comptent depuis le bord (`data-bord`). */
  }
  <i class="case" style="--x:0;--y:0;--c:var(--appoint-2)" aria-hidden="true"
  ></i>
  <i class="case" style="--x:1;--y:1;--c:var(--appoint-1)" aria-hidden="true"
  ></i>
  <i
    class="case"
    data-bord="droit"
    style="--x:0;--y:0;--c:var(--appoint-4)"
    aria-hidden="true"></i>
  <i
    class="case"
    data-bord="droit"
    style="--x:1;--y:1;--c:var(--appoint-5)"
    aria-hidden="true"></i>
  <div class="container-custom border-divider xl:border-l xl:border-r">
    <div class="grid grid-cols-1 items-stretch lg:grid-cols-12">
      {/* Le message */}
      <div
        class="flex flex-col justify-center px-6 pb-14 pt-24 md:px-10 md:pb-20 lg:col-span-8"
      >
        <span class="eyebrow block" data-reveal>
          Agents IA, automatisation, formation · Suisse romande
        </span>

        <h1 class="type-display-mega reveal-nu mt-5" data-reveal>
          <span class="ligne-masquee"
            ><span>Automatisez votre business</span></span
          >
          <span class="ligne-masquee"><span><em>avec l'IA</em></span></span>
        </h1>

        <p
          class="mt-8 max-w-2xl text-lg leading-relaxed text-grey text-pretty md:mt-10 md:text-xl"
          data-reveal
          data-reveal-delay="2"
        >
          J'aide les indépendants et les PME de Suisse romande à confier à l'IA
          ce qui leur prend du temps, agents, automatisations et formation, pour
          se concentrer sur le travail qui compte.
        </p>

        <div
          class="mt-10 grid grid-cols-3 gap-5 border-t border-divider pt-8 md:mt-12 md:gap-8 md:pt-10"
        >
          {
            chiffres.map((chiffre, index) => (
              <div data-reveal data-reveal-delay={String(index + 2)}>
                <div class="stat-value text-2xl sm:text-3xl md:text-4xl">
                  {chiffre.valeur}
                </div>
                <div class="mt-2 font-mono text-[11px] uppercase leading-relaxed tracking-[0.14em] text-grey">
                  {chiffre.libelle}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      {
        /* La carte profil — elle occupe toute la colonne et porte les actions */
      }
      <div
        class="flex flex-col justify-center border-t border-divider px-6 py-14 md:px-8 md:py-20 lg:col-span-4 lg:border-l lg:border-t-0"
        data-reveal
        data-reveal-delay="2"
      >
        <div
          class="objet mx-auto flex w-full max-w-sm flex-col items-center p-8 text-center md:p-10 lg:max-w-none"
        >
          <div
            class="h-28 w-28 overflow-hidden rounded-full bg-paper md:h-32 md:w-32"
          >
            <img
              src="/images/emmanuel-bernard-expert-automatisation-ia-n8n-lausanne-suisse-romande-avatar.webp"
              alt="Emmanuel Bernard, expert en automatisation et agents IA à Lausanne"
              class="h-full w-full object-cover"
              width="128"
              height="128"
              loading="eager"
            />
          </div>

          <p
            class="mt-6 font-serif text-3xl leading-tight text-ink md:text-4xl"
          >
            Emmanuel Bernard
          </p>
          <p class="mt-3 text-lg leading-relaxed text-grey">
            Développeur et formateur IA<br />Fondateur d'AVQN
          </p>

          <div class="mt-8 flex w-full flex-col gap-3">
            <a href="/contact" class="btn-primary w-full py-4">
              Parler de votre projet
              <span aria-hidden="true">→</span>
            </a>
            <a href="#offres" class="btn-outline w-full py-4">Voir les offres</a
            >
          </div>

          <p
            class="mt-6 font-mono text-[11px] uppercase tracking-[0.16em] text-grey"
          >
            Lausanne et visio
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
