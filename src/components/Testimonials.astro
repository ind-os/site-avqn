---
/**
 * Carrousel du corpus complet des témoignages, titre fixe.
 * Le corpus vit dans `src/data/temoignages.ts`.
 */
import { temoignages } from "../data/temoignages";
import TestimonialsCarousel from "./TestimonialsCarousel.tsx";
---

<section class="border-b border-divider">
  <div class="container-custom border-divider xl:border-l xl:border-r">
    <div class="border-b border-divider px-6 md:px-8 py-10">
      <h2 class="type-display-section text-4xl md:text-6xl">Témoignages</h2>
    </div>
    <div class="px-6 md:px-8 py-12 md:py-16">
      <TestimonialsCarousel client:load testimonials={temoignages} />
    </div>
  </div>
</section>
